# Sui Network Configuration
# Bu dosyayı .env olarak kopyalayın: cp env.copy .env
# Sonra aşağıdaki değerleri doldurun

# Sui Network (testnet, devnet, mainnet)
VITE_SUI_NETWORK=testnet

# Contract Addresses (Contract deploy edildikten sonra doldurun)
# Contract deploy komutu: cd move && sui client publish --gas-budget 100000000
# Deploy sonrası çıkan Package ID'yi buraya yapıştırın
VITE_CONTRACT_PACKAGE_ID=

# GameConfig Object ID (Deploy sonrası oluşturulan GameConfig object'inin ID'si)
# Bu ID'yi deploy çıktısından veya Sui Explorer'dan bulabilirsiniz
VITE_CONTRACT_GAME_CONFIG_ID=

# Örnek:
# VITE_SUI_NETWORK=testnet
# VITE_CONTRACT_PACKAGE_ID=0x1234567890abcdef1234567890abcdef12345678
# VITE_CONTRACT_GAME_CONFIG_ID=0xabcdef1234567890abcdef1234567890abcdef12

